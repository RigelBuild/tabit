{
	"prefilter": {
		"ere": "orion|sealed|SEA-[0-9]|infra/pulumi|personal/matt|tools/saiph|ci/workflows|oss/petrel",
		"ignoreCase": true
	},
	"patterns": [
		{ "source": "\\borion\\b", "flags": "i" },
		{ "source": "\\bsealed/[a-z]", "flags": "i" },
		{
			"source": "\\bsealed\\s+[\\w.-]+(?:/[\\w.-]+)*\\.(?:ts|tsx|js|jsx|go|nix|md|json5?|ya?ml|toml|sh|py|rs|lock)\\b",
			"flags": "i"
		},
		{ "source": "\\bsealed-(?:repo|monorepo|docs|private)\\b", "flags": "i" },
		{ "source": "\\bsealed's\\b", "flags": "i" },
		{
			"source": "\\bsealed (repo|monorepo|design corpus|platform|convention|PR #)",
			"flags": "i"
		},
		{ "source": "\\bSEA-\\d+\\b", "flags": "" },
		{
			"source": "\\b(?:infra/pulumi|personal/matt|tools/saiph|ci/workflows|oss/petrel)/",
			"flags": "i"
		}
	],
	"ignore": [],
	"carveOutPaths": ["ref-gate.config.json", "bun.lock"],
	"carveOutPrefixes": [],
	"allowlist": {},
	"remediationDoc": "README.md"
}
